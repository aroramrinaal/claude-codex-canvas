#!/bin/sh
set -eu
script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
if [ -n "${CANVAS_PYTHON:-}" ]; then
  exec "$CANVAS_PYTHON" "$script_dir/canvas.py" "$@"
elif command -v uv >/dev/null 2>&1; then
  exec uv run --script "$script_dir/canvas.py" "$@"
else
  exec python3 "$script_dir/canvas.py" "$@"
fi
